{
  "name": "build-frontend-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Build process for frontend assets",
  "main": "index.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "bundle": "node build.mjs -f \"assets-src/*.js\" -o \"assets\"",
    "watch": "npm run bundle",
    "build": "npm run bundle -- --production",
    "generate-pot": "tools/make-pot.sh",
    "env": "wp-env",
    "env:test": "wp-env --config .wp-env.test.json",
    "wp": "wp-env run cli wp --env-cwd=wp-content/plugins/rh-seo",
    "test": "npm run test:pest && npm run env:test reset && npm run env:test start && npm run test:e2e",
    "test:pest": "wp-env --config .wp-env.test.json run cli --env-cwd=wp-content/plugins/rh-seo vendor/bin/pest --no-coverage",
    "test:e2e": "playwright test --config ./tests/E2E/playwright.config.ts",
    "test:e2e:install": "playwright install --with-deps firefox"
  },
  "author": "Rasso Hilber",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@wordpress/env": "^12.1.0",
    "esbuild": "^0.28.2",
    "sass": "^1.26.5"
  }
}
